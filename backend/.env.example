# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rfp_ai_db

# Gmail API (used in later modules)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# AI Provider (Grok / LLaMA etc.)
AI_PROVIDER=LLAMA

OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
